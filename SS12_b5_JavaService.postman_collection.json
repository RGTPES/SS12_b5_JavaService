{
  "info": {
    "name": "SS12 b5 JavaService - Product API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    }
  ],
  "item": [
    {
      "name": "Get all products",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/products"
      }
    },
    {
      "name": "Create product",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Laptop\",\n  \"price\": 1500.0,\n  \"quantity\": 5\n}"
        },
        "url": "{{baseUrl}}/api/products"
      }
    },
    {
      "name": "Get product by id",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/products/1"
      }
    },
    {
      "name": "Update product",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Gaming Laptop\",\n  \"price\": 1800.0,\n  \"quantity\": 3\n}"
        },
        "url": "{{baseUrl}}/api/products/1"
      }
    },
    {
      "name": "Delete product",
      "request": {
        "method": "DELETE",
        "url": "{{baseUrl}}/api/products/1"
      }
    },
    {
      "name": "Get missing product - 404",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/products/999"
      }
    }
  ]
}
